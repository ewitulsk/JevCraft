# Keep real credentials in .env or environment variables. .env is ignored by Git.
JEVCRAFT_PROVIDER=vercel_gateway
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=
JEVCRAFT_MAX_CONCURRENT=2
# Optional hard ceiling for accepted server-side input tokens during one process lifetime.
JEVCRAFT_MAX_INPUT_TOKENS=9223372036854775807
# Used only for the displayed estimate; confirm current provider pricing for your account.
JEVCRAFT_INPUT_USD_PER_MILLION=0.04
